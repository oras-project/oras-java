{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":prHourlyLimitNone",
    ":semanticCommitsDisabled",
    ":configMigration",
    ":prConcurrentLimitNone",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":enablePreCommit",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "rebaseWhen": "conflicted"
}
